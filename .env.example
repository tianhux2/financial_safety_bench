# ==============================================================================
# Environment Configuration Template for Financial Agent Safety Bench
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit your real .env file to version control.
# ==============================================================================

# Search API Key (Required for web search tools)
TAVILY_API_KEY=your_tavily_api_key_here

# LLM API Keys (Configure based on which models you evaluate or use as judges)
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
DEFAULT_MODEL=gpt-4o

# Financial Data Tools
PRICING_DATA_API_KEY=your_pricing_api_key_here
# SEC_EDGAR_API_KEY=your_sec_edgar_api_key_here

# SEC EDGAR requires a contact in the User-Agent, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=your_name your_email@example.com

# Optional: path to FrontierFinance's frontier_finance_public.jsonl (gated on Hugging Face).
# Needed only to build and run the cases derived from it. Default: data/frontier_finance_public.jsonl
# FRONTIER_FINANCE_DATA=data/frontier_finance_public.jsonl
